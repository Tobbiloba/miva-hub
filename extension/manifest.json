{
  "manifest_version": 3,
  "name": "Askly Capture",
  "version": "0.1.1",
  "description": "Capture MIVA University lesson content for the Askly AI study assistant",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": [
    "https://lms.miva.university/*",
    "https://player.vimeo.com/*",
    "https://lms-assets.miva.university/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://lms.miva.university/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
